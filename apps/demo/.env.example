# The demo runs on the built-in mock ledger unless VITE_USE_LIVE_API=true.
# Live mode is for a local or private sandbox API only: never point a public demo build at a ledger.
VITE_USE_LIVE_API=false
# Set after deploying ledger-api-cdk (ApiUrl stack output) and creating accounts.
VITE_LEDGER_API_URL=
VITE_PRIMARY_ACCOUNT_ID=
VITE_PRIMARY_ACCOUNT_NAME=Operating
# id:Display name pairs, comma separated
VITE_COUNTERPARTY_ACCOUNTS=
